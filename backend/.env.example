# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workscribe_db

# Connection pool. Free-tier Postgres allows very few connections and every
# worker process opens its own pool — keep these small in production.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Set true ONLY when DATABASE_URL points at a transaction-mode pooler
# (Supabase port 6543, PgBouncer). Disables asyncpg prepared-statement caching,
# which is incompatible with transaction pooling and otherwise causes random
# InvalidSQLStatementName errors.
DB_USE_PGBOUNCER=false

# Redis
# Managed providers (Upstash etc.) generally require TLS — use rediss:// not
# redis:// for those, or every connection will be refused.
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# JWT
JWT_SECRET_KEY=your-secret-key-min-32-chars-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Email - Brevo
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=noreply@workscribe.app

# CORS — accepts a single origin, a comma-separated list, or a JSON array.
# Must match the browser's Origin exactly, with no trailing slash.
#   CORS_ORIGINS=https://work-scribe.vercel.app
#   CORS_ORIGINS=https://work-scribe.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
