# Base URL of the WorkScribe API, including the /api/v1 prefix and no trailing
# slash. The WebSocket URL is derived from this value.
#   local:      http://localhost:8001/api/v1
#   production: https://workscribe-api.onrender.com/api/v1
VITE_API_URL=http://localhost:8001/api/v1

# Analytics (optional — the app runs fine without these)
VITE_EVENTPULSE_API_KEY=
VITE_EVENTPULSE_ENDPOINT=
